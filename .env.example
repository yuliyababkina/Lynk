# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# If these are left unset, the app automatically falls back to the static
# mock data in src/data.ts — nothing breaks, it just won't persist actions.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Real invite emails (api/send-invite.js) — see SETUP.md "Sending real
# invitation emails" for the full walkthrough.
#
# IMPORTANT: no VITE_ prefix on these two — that prefix tells Vite to inline
# a variable into the browser bundle. These must stay server-only, so the
# Resend secret key is never shipped to the client.
#
# Only used by `vercel dev` / the deployed app (plain `npm run dev` does not
# run /api functions at all — that's a Vercel-only runtime).

RESEND_API_KEY=re_your_resend_secret_key
RESEND_FROM=Lynk <invites@yourdomain.com>
