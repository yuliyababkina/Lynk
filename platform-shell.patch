+import { Bell, Globe, LogOut, ScanEye, UserRound } from "lucide-react";
+import { Avatar, AvatarFallback } from "@/components/ui/avatar";
+import { cn } from "@/lib/utils";
+import { buttonVariants } from "@/components/ui/button";
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuGroup,
+  DropdownMenuItem,
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger,
+} from "@/components/ui/dropdown-menu";
+import { Separator } from "@/components/ui/separator";
+import { Tooltip, TooltipContent, TooltipTrigger } from "@/components/ui/tooltip";
+import { useI18n, type Lang } from "@/lib/i18n";
+import { AppSwitcher } from "./AppSwitcher";
+import { ROLES, type PlatformApp, type RoleId } from "./apps";
+
+/*
+ * Shell header — the platform's, not any app's.
+ *
+ * Left: brand and where you are (app name only — the page title is the app's
+ * business and sits in its own content area). Right: everything that is the
+ * same in every app — the global app switcher, notifications, language and the
+ * signed-in user. The user's profile lives here, not in an app's sidebar:
+ * resetting a password is a platform task (Thomas, 28 Oct).
+ */
+export function ShellHeader({
+  apps,
+  activeApp,
+  onSelectApp,
+  role,
+  onRoleChange,
+  inspector,
+  onInspectorChange,
+}: {
+  apps: PlatformApp[];
+  activeApp?: PlatformApp;
+  onSelectApp: (id: string) => void;
+  role: RoleId;
+  onRoleChange: (role: RoleId) => void;
+  inspector: boolean;
+  onInspectorChange: (on: boolean) => void;
+}) {
+  const { t, lang, setLang } = useI18n();
+  const user = ROLES.find((r) => r.id === role)!;
+
+  return (
+    <header className="flex h-12 shrink-0 items-center gap-3 border-b bg-card px-4">
+      <div className="flex items-center gap-2">
+        <span className="flex size-7 items-center justify-center rounded-md bg-primary text-sm font-bold text-primary-foreground">
+          Y
+        </span>
+        <span className="text-sm font-semibold">Yarowa</span>
+      </div>
+      {activeApp ? (
+        <>
+          <Separator orientation="vertical" className="h-5" />
+          <span className="truncate text-sm text-muted-foreground">{t(activeApp.name)}</span>
+        </>
+      ) : null}
+
+      <div className="flex-1" />
+
+      <AppSwitcher apps={apps} activeId={activeApp?.id ?? ""} onSelect={onSelectApp} />
+
